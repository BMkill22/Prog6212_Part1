@if (User.Identity.IsAuthenticated)
{
    if (User.IsInRole("Lecturer"))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Claim" asp-action="Create">Submit Claim</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Claim" asp-action="Index">My Claims</a>
        </li>
    }

    if (User.IsInRole("Manager"))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Claim" asp-action="ManagerView">Manager Dashboard</a>
        </li>
    }

    // NEW: HR Link
    if (User.IsInRole("HR"))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Claim" asp-action="HRDashboard">HR Invoices</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Claim" asp-action="LecturerDirectory">Manage Lecturers</a>
        </li>
    }
}